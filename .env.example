# Copia este archivo a .env.local y rellena los valores.
# Ninguna variable lleva el prefijo NEXT_PUBLIC_: ese prefijo mete el valor en
# el JavaScript que se descarga el navegador, y la clave de Resend ahí es una
# clave regalada.

# Clave de API de Resend. Obligatoria para que el formulario de contacto envíe.
# Panel de Resend > API Keys. En Vercel, márcala como Sensitive y actívala en
# Production, Preview y Development.
RESEND_API_KEY=

# Buzón donde llegan los avisos del formulario.
# Opcional: si falta, el código usa lucas@publiqo.es.
# Ojo: si esta variable ya está puesta en Vercel con otro valor, gana ella y el
# formulario seguirá llegando al buzón antiguo. Cámbiala allí o bórrala.
CONTACT_TO_EMAIL=

# Remitente del aviso. Debe estar en un dominio verificado en Resend.
# Opcional: por defecto "Formulario lucasalvarez.info <formulario@lucasalvarez.info>".
CONTACT_FROM_EMAIL=

# Remitente del acuse de recibo que recibe quien rellena el formulario.
# Opcional: por defecto "Lucas Álvarez <hola@lucasalvarez.info>".
CONTACT_REPLY_FROM_EMAIL=

# Token de verificación de Google Search Console.
# Search Console > Añadir propiedad > Etiqueta HTML: copia solo el valor
# del atributo content, sin las comillas ni la etiqueta entera.
GOOGLE_SITE_VERIFICATION=

# Token de verificación de Bing Webmaster Tools (msvalidate.01).
# Bing es el índice que alimenta Copilot y la búsqueda web de ChatGPT: sin dar
# de alta el dominio ahí, el sitio no puede aparecer en sus respuestas.
# Se puede importar la propiedad desde Search Console en un clic.
BING_SITE_VERIFICATION=

# Secreto del cron de Vercel. Al definirlo en el proyecto, Vercel manda
# "Authorization: Bearer <valor>" en cada ejecución programada y las rutas de
# /api/cron rechazan cualquier otra cosa. Sin esta variable las rutas
# devuelven 500 en vez de quedarse abiertas.
CRON_SECRET=

# Deploy hook del proyecto en Vercel (Settings > Git > Deploy Hooks).
# El cron diario le hace POST a las 06:00 UTC y ese build es el que publica
# el post del día: el sitio es estático, así que la fecha se resuelve al
# construir. Sin esta variable no se publica nada nuevo.
DEPLOY_HOOK_URL=
